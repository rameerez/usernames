class <%= migration_class_name %> < ActiveRecord::Migration<%= migration_version %>
  def change
<% if add_column? -%>
<% if collation.nil? && adapter == :postgresql -%>
    # No collation of its own: the unique index below compares through
    # lower(<%= column %> COLLATE "C"), byte by byte, whatever the column's
    # collation is — so ORDER BY <%= column %> keeps the database's own order.
<% else -%>
    # Compared byte by byte (<%= collation ? "collation #{collation.inspect}" : "SQLite's default" %>), so the database agrees
    # with Ruby about what "the same name" means: no locale lowercasing I to
    # ı, no collation that thinks jose and josé are one name.
<% end -%>
    add_column :<%= table %>, :<%= column %>, :string<%= column_options %>
<% elsif change_collation? -%>
<% if collation -%>
    # Compared byte by byte ("C"), so the database agrees with Ruby about what
    # "the same name" means: no locale lowercasing I to ı, no collation that
    # ignores case or punctuation. Run `rails usernames:audit` first.
<% else -%>
    # citext compares under the database locale; the gem compares through
    # lower(<%= column %> COLLATE "C") on a plain string column. Run
    # `rails usernames:audit` first.
<% end -%>
    reversible do |direction|
      direction.up { change_column :<%= table %>, :<%= column %>, :string<%= column_options %> }
    end
<% elsif mysql_collation_note? -%>
    # The comparison contract wants a byte-wise collation. MySQL's change_column
    # restates the whole column, so restate its null/default here too:
    # change_column :<%= table %>, :<%= column %>, :string, collation: <%= collation.inspect %>
<% end -%>
<% if (existing = conflicting_index) -%>
<% if column_step? -%>

<% end -%>
    # <%= existing.name %> isn't the unique index the gem needs; replace it.
    <%= Usernames::Generators::ExistingSchema.remove_index_line(table, existing) %>
<% end -%>
<% if add_index? -%>
<% if column_step? || conflicting_index -%>

<% end -%>
<% if mode == :preserve -%>
    # Case is kept as typed, and compared without it: CoolCat and coolcat are
    # one name. Every query the gem makes uses this same expression.
<% else -%>
    # Usernames are stored lowercase, so a plain unique index is the whole
    # contract: uniqueness is `<%= column %> = ?`, and this index serves it.
<% end -%>
    add_index :<%= table %>, <%= index_column %>, unique: true, name: <%= index[:name].inspect %>
<% end -%>
  end
end

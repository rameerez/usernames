# frozen_string_literal: true

module Usernames
  # GET /usernames/availability?username=javi
  #   => { "state": "free" | "taken" | "invalid", "message": "…" }
  #
  # Generated by `rails generate usernames:availability`. It's yours: edit it.
  #
  # An availability endpoint tells anyone which names exist — that is its
  # job — so it comes with guard rails:
  #
  # * Rails' own rate_limit, on a store this controller checks. With the
  #   NullStore (Rails' default in development and test) the limiter silently
  #   counts nothing, so in production this answers 503, with a log line,
  #   until config.cache_store is a shared store (Solid Cache, Redis,
  #   Memcached). A MemoryStore works, but per process: each worker counts on
  #   its own, so it logs a warning once.
  # * Taken, reserved and not-allowed names all answer "taken", with one
  #   message: it never says which list a name is on, or which word matched.
  # * Never cached (no-store), and advisory only: the model's validations and
  #   the unique index decide at save time.
  class AvailabilityController < ApplicationController
    # Captured once: the very object the limiter writes to, so the guard
    # below checks the store that is actually in use.
    RATE_LIMIT_STORE = cache_store

    MEMORY_STORE_WARNED = Concurrent::AtomicBoolean.new(false)

    # Format failures are shown as they are (the browser hints them anyway);
    # reserved and not-allowed names are reported as taken (see above).
    FORMAT_FAILURES = %i[
      username_spaces username_characters username_unicode too_short too_long username_edges
      username_consecutive username_first_character username_digits_only username_extension
    ].freeze

    rate_limit to: 30, within: 1.minute, store: RATE_LIMIT_STORE, with: -> { head :too_many_requests }

    before_action :require_a_working_rate_limit_store

    def show
      response.headers["Cache-Control"] = "no-store"
      render json: answer_for(params[:<%= column %>].to_s)
    end

    private

    def answer_for(value)
      result = Usernames.check(value, **rules)

      if result.canonical.empty?
        { state: "invalid", message: I18n.t("errors.messages.blank") }
      elsif own?(result.canonical)
        { state: "free", message: nil }
      elsif FORMAT_FAILURES.include?(result.reason)
        { state: "invalid", message: result.message }
      elsif result.ok? && <%= model_name %>.<%= column %>_available?(result.canonical)
        { state: "free", message: nil }
      else
        { state: "taken", message: I18n.t("errors.messages.taken") }
      end
    end

    def rules
      <%= model_name %>.<%= column %>_options
    end

    # The signed-in person's own name is free: it's theirs. Devise and most
    # authentication gems define current_user; with Rails' own authentication
    # generator, use Current.user instead.
    def own?(canonical)
      user = current_user if respond_to?(:current_user, true)
      name = user.try(:<%= column %>)
      name.present? && Usernames.comparison_key(name, **rules) == Usernames.comparison_key(canonical, **rules)
    end

    def require_a_working_rate_limit_store
      case RATE_LIMIT_STORE
      when ActiveSupport::Cache::NullStore
        return unless Rails.env.production?

        Rails.logger.error "[usernames] The availability check is off (503): config.cache_store is the NullStore, " \
                           "where Rails' rate_limit counts nothing. Use a shared store: Solid Cache, Redis or Memcached."
        head :service_unavailable
      when ActiveSupport::Cache::MemoryStore
        if MEMORY_STORE_WARNED.make_true
          Rails.logger.warn "[usernames] The availability check's rate limit uses a MemoryStore, which each process " \
                            "counts on its own. Use a shared store (Solid Cache, Redis, Memcached) for one limit per client."
        end
      end
    end
  end
end

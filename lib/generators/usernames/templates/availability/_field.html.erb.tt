<%%# locals: (form:, attribute: :<%= column %>, label: nil) -%>
<%%#
  A username field with live hints and an availability check.
  Generated by `rails generate usernames:availability`. It's yours: edit it.

  Render it inside a form, handing it the form builder:

    render "usernames/field", form: form

  Hints are advisory: nothing here stops the form from submitting, and the
  model's validations have the last word.
-%>
<div data-controller="username-check"
     data-username-check-url-value="<%%= usernames_availability_path %>"
     data-username-check-param-value="<%= column %>"
     data-username-check-rules-value="<%%= <%= model_name %>.<%= column %>_rules_for_browser.to_json %>"
     data-username-check-lowercase-value="<%%= <%= model_name %>.<%= column %>_options[:case] != :preserve %>">
  <%%= form.label attribute, label %>
  <%%= form.text_field attribute,
        autocomplete: "username", autocapitalize: "none", autocorrect: "off", spellcheck: false,
        aria: { describedby: "#{form.field_id(attribute)}_hint #{form.field_id(attribute)}_status" },
        data: { username_check_target: "input", action: "input->username-check#check" } %>
  <p id="<%%= form.field_id(attribute) %>_hint" data-username-check-target="hint" aria-live="polite"></p>
  <p id="<%%= form.field_id(attribute) %>_status" data-username-check-target="status" aria-live="polite"></p>
</div>

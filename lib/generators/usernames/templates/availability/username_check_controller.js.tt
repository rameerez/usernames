import { Controller } from "@hotwired/stimulus"

// Live hints and a "is this name free?" check for <%= model_name %>#<%= column %>.
// Generated by `rails generate usernames:availability`. It's yours: edit it.
// app/views/usernames/_field.html.erb wires it up:
//
//   <div data-controller="username-check"
//        data-username-check-url-value="/usernames/availability"
//        data-username-check-param-value="<%= column %>"
//        data-username-check-rules-value="[…<%= model_name %>.<%= column %>_rules_for_browser…]">
//     <input data-username-check-target="input" data-action="input->username-check#check">
//     <p data-username-check-target="hint"></p>
//     <p data-username-check-target="status"></p>
//   </div>
//
// Everything here is a HINT. The browser only approximates the server's
// normalisation (Ruby's strip and JavaScript's trim() disagree on NUL, U+FEFF
// and U+1680), so nothing here blocks submission: no setCustomValidity, no
// pattern attribute. The model's validations and the unique index decide.
export default class extends Controller {
  static targets = ["input", "hint", "status"]
  static values = {
    url: String,
    // The query parameter the endpoint reads: GET /usernames/availability?<%= column %>=…
    param: { type: String, default: "<%= column %>" },
    rules: Array,
    lowercase: { type: Boolean, default: true },
    delay: { type: Number, default: 300 }
  }

  connect() {
    this.patterns = this.rulesValue.map((rule) => ({ ...rule, regexp: this.compile(rule.pattern) }))
  }

  disconnect() {
    this.cancel()
  }

  // On every keystroke: the first rule the name breaks, at once; whether it
  // is free, once typing pauses.
  check() {
    const name = this.normalize(this.inputTarget.value)
    this.current = name
    this.cancel()

    const broken = this.firstBrokenRule(name)
    this.write(this.hasHintTarget && this.hintTarget, broken ? broken.message : "")
    this.render(null)
    // Only names that could be registered are worth a request.
    if (name === "" || broken) return

    this.timer = setTimeout(() => this.ask(name), this.delayValue)
  }

  async ask(name) {
    this.request = new AbortController()
    const url = new URL(this.urlValue, window.location.href)
    url.searchParams.set(this.paramValue, name)

    try {
      const response = await fetch(url, {
        headers: { Accept: "application/json" },
        signal: this.request.signal,
        credentials: "same-origin"
      })
      if (!response.ok) return // rate-limited or switched off: say nothing rather than guess

      const answer = await response.json()
      // A slow answer for something typed earlier is not an answer for this.
      if (name === this.current) this.render(answer)
    } catch (error) {
      if (error.name !== "AbortError") throw error
    }
  }

  // The server's normalisation, approximately: NFKC, trim,
  // lowercase (unless case is kept), one leading @ before a letter or digit.
  normalize(value) {
    let name = value.normalize("NFKC").trim()
    if (this.lowercaseValue) name = name.toLowerCase().normalize("NFKC")
    return name.replace(this.lowercaseValue ? /^@(?=[a-z0-9])/ : /^@(?=[A-Za-z0-9])/, "")
  }

  // Each pattern matches a name that BREAKS its rule; the first one wins.
  firstBrokenRule(name) {
    if (name === "") return null
    return this.patterns.find(({ regexp }) => regexp && regexp.test(name)) || null
  }

  // With the u flag a length counts code points, as Ruby does.
  compile(pattern) {
    try {
      return new RegExp(pattern, "u")
    } catch {
      try { return new RegExp(pattern) } catch { return null }
    }
  }

  render(answer) {
    if (!this.hasStatusTarget) return

    this.statusTarget.dataset.state = answer ? answer.state : ""
    this.write(this.statusTarget, answer && answer.message ? answer.message : "")
  }

  write(element, text) {
    if (element) element.textContent = text
  }

  cancel() {
    clearTimeout(this.timer)
    if (this.request) this.request.abort()
    this.request = null
  }
}
